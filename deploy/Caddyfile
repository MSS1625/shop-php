# ============================================================
#  دیجی‌شاپ — Caddy: پروکسی معکوس با HTTPS خودکار
#
#  دامنه از متغیر محیطی DIGISHOP_DOMAIN خوانده می‌شود (توسط
#  docker-compose.prod.yml ست می‌شود)؛ Caddy برای آن گواهی
#  Let's Encrypt می‌گیرد، HTTP را به HTTPS ریدایرکت می‌کند و
#  تمدید گواهی را هم خودش مدیریت می‌کند — بدون هیچ کانفیگ اضافه.
#
#  شرط فقط یکی است: رکورد A دامنه باید قبل از اجرا به IP سرور
#  اشاره کند و پورت‌های 80 و 443 از بیرون باز باشند.
# ============================================================

{$DIGISHOP_DOMAIN} {
	# فشرده‌سازی پاسخ‌ها
	encode zstd gzip

	# همهٔ درخواست‌ها به سرویس web (nginx) پاس می‌شوند
	reverse_proxy web:80
}
