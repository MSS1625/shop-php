APP_NAME="دیجی‌شاپ"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tehran
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FAKER_LOCALE=fa_IR
APP_FALLBACK_LOCALE=en

# ایمیل مدیر اولیه (با دستور php artisan admin:create یا seeder ساخته می‌شود)
SHOP_ADMIN_EMAIL=admin@digishop.local
# اگر خالی باشد، رمز تصادفی قوی ساخته و در خروجی کنسول نمایش داده می‌شود
ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─────────────────────────────────────────────
# دیتابیس — روش ۱: SQLite (بدون نیاز به تنظیم، پیش‌فرض)
# ─────────────────────────────────────────────
DB_CONNECTION=sqlite

# ─────────────────────────────────────────────
# دیتابیس — روش ۲: MySQL/MariaDB (برای XAMPP)
# خط بالا را کامنت و ۴ خط زیر را از کامنت خارج کنید:
# ─────────────────────────────────────────────
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=shop_php
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
