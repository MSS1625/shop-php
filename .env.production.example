# ============================================================
#  دیجی‌شاپ — تنظیمات استک پروداکشن | Production stack settings
#
#  این فایل را کپی و ویرایش کنید:
#      cp .env.production.example .env.production
#
#  و بعد، کنار همین فایل در ریپو:
#      docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build --wait
#
#  این فایل فقط برای docker compose خوانده می‌شود؛ داخل کانتینر،
#  اپ همان .env.docker خودش را دارد و مقدارهای حساس از اینجا به‌صورت
#  متغیر محیطی به آن تزریق می‌شود (رک APP_URL و رمزهای دیتابیس).
#
#  راهنمای کامل (سرور رایگان، DNS، بکاپ): docs/DEPLOY.fa.md
# ============================================================

# ─── دامنه ───────────────────────────────────────────────
# رکورد A دامنه باید قبل از اجرا به IP سرور اشاره کند
DIGISHOP_DOMAIN=shop.example.com

# ─── دیتابیس ─────────────────────────────────────────────
# رمزهای قوی و یکتا انتخاب کنید (این مقادیر فقط بین این فایل و خودتان می‌مانند)
DB_DATABASE=digishop
DB_USERNAME=digishop
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-strong-root-password

# ─── مدیر فروشگاه (اختیاری) ──────────────────────────────
# ADMIN_PASSWORD را خالی بگذارید تا رمز تصادفی قوی ساخته شود و
# یک‌بار در «docker compose --env-file .env.production logs app» چاپ شود
SHOP_ADMIN_EMAIL=admin@digishop.local
ADMIN_PASSWORD=
