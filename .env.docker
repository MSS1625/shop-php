APP_NAME="دیجی‌شاپ"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=http://localhost:8080

APP_LOCALE=fa
APP_FAKER_LOCALE=fa_IR
APP_FALLBACK_LOCALE=en

# ─────────────────────────────────────────────
# مدیر پنل (اولین seed دیتابیس ساخته می‌شود)
# ایمیل پیش‌فرض: admin@digishop.local
# ADMIN_PASSWORD خالی باشد → رمز تصادفی قوی ساخته و یک‌بار در لاگ
# کانتینر نمایش داده می‌شود:  docker compose logs app
# برای مقدار ثابت، اینجا تنظیم کنید و بعد:  docker compose up -d --build
# ─────────────────────────────────────────────
SHOP_ADMIN_EMAIL=admin@digishop.local
ADMIN_PASSWORD=

# لاگ‌ها به stderr می‌روند → با «docker compose logs app» دیده می‌شوند
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ─────────────────────────────────────────────
# دیتابیس — سرویس db در docker-compose.yml
# (این مقادیر با environment سرویس db هماهنگ‌اند)
# ─────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=digishop
DB_USERNAME=digishop
DB_PASSWORD=digishop

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# ایمیل‌ها به‌جای ارسال واقعی در لاگ کانتینر ثبت می‌شوند؛
# برای ارسال واقعی SMTP را تنظیم و MAIL_MAILER=smtp کنید
MAIL_MAILER=log

# ─────────────────────────────────────────────
# اطلاع‌رسانی سفارش (mail و/یا sms)
# ─────────────────────────────────────────────
SHOP_NOTIFICATIONS=true
SHOP_NOTIFICATION_CHANNELS=mail

# درگاه پیامک: log = فقط ثبت در لاگ | kavenegar = ارسال واقعی
SMS_DRIVER=log
KAVENEGAR_API_KEY=
KAVENEGAR_FROM=

# ─────────────────────────────────────────────
# درگاه پرداخت زرین‌پال
# mock = شبیه‌ساز محلی (پیش‌فرض و بی‌خطر) | sandbox | production
# برای دموی کامل پرداخت داخل کانتینر همان mock کافی است
# ─────────────────────────────────────────────
ZARINPAL_MERCHANT_ID=
ZARINPAL_MODE=mock
ZARINPAL_AMOUNT_MULTIPLIER=10
